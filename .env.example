# Spotify API Credentials
# Get your credentials from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Genius API Credentials
# Get your access token from https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=your_genius_access_token_here

# Supabase Configuration
# Get your credentials from your Supabase project settings
# URL format: https://your-project.supabase.co
SUPABASE_URL=your_supabase_project_url_here
# Use the service_role key for backend operations (keep secret!)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
# Use the anon key for frontend operations
SUPABASE_ANON_KEY=your_supabase_anon_key_here
