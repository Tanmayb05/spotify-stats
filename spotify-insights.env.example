# Spotify API Credentials
# Get your credentials from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Genius API Credentials
# Get your access token from https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=your_genius_access_token_here

# Database backend: "supabase" (default) or "local".
# `docker compose up` sets this to local and needs none of the Supabase values
# below. See documentation/LOCAL_DEV.md.
DB_BACKEND=supabase

# Local Postgres (only used when DB_BACKEND=local).
# Compose injects this automatically; set it only when running natively
# against a local database.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/spotify

# Supabase Configuration (only used when DB_BACKEND=supabase)
# Get your credentials from your Supabase project settings
# URL format: https://your-project.supabase.co
SUPABASE_URL=your_supabase_project_url_here
# Use the service_role key for backend operations (keep secret!)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
# Use the anon key for frontend operations
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Comma-separated CORS origins. Unset = the four dev/prod defaults.
# CORS_ORIGINS=http://localhost:3010,http://localhost:5173

# Optional: Last.fm API key for scripts/backfill_artist_tags.py (Phase 11,
# Decision D5). Get one at https://www.last.fm/api/account/create. The script
# also queries MusicBrainz (no key needed) and is fully skippable
# (--skip-backfill) -- unset this and the phase still completes, with lower
# genre coverage.
# LASTFM_API_KEY=your_lastfm_api_key_here
