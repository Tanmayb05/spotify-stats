.cache

# --- Personal data: never commit a real Spotify export -------------------------
# Spotify GDPR exports contain third-party PII (ip_addr, and depending on the
# package: email / postal address / payment records). All raw data stays local.
# See data/README.md and SECURITY.md.
data/raw/
data/other users/
data/Spotify Account Data/
data/*.json
data/*.csv
# ...but keep the tiny synthetic CI fixture:
!data/fixtures/
!data/fixtures/**

# Large enriched blobs — reproduced by the enrichment jobs, not committed.
outputs/data/*.json
outputs/lyrics/
# ...but keep the small aggregate CSVs the current app reads:
!outputs/data/*.csv

# Phase 11: pre/post-migration API snapshots (real listening history) and the
# MusicBrainz/Last.fm artist-tag cache -- both reproducible, neither committed.
outputs/baseline/
outputs/enrichment/

# Local scratch copies of moved data
archived/


# IMPORTANT: Allow package.json and related files for builds
!package.json
!package-lock.json
!tsconfig*.json
!**/package.json
!**/package-lock.json
!**/tsconfig*.json

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb

# Environment
spotify-insights.env
spotify-insights.env.local
.env
.env.local
*.env
# ...but the example stubs are meant to be committed:
!*.env.example

# Node.js / Frontend
node_modules/
apps/web/dist/
apps/web/build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Backend (uses root .venv, not local venv)
apps/api/__pycache__/
apps/api/.pytest_cache/
apps/api/.coverage
apps/api/htmlcov/

# Outputs: keep aggregate CSVs, images and dashboards (checked in above rules);
# generated JSON blobs and lyrics are ignored via the personal-data block.
