# # Spotify Data - PRIVATE
# data/
# *.json
.cache

# Extracted other-users streaming history (contains third-party PII: ip_addr).
# The source .zip archives are tracked; extracted per-user dirs are not.
data/other users/*/


# IMPORTANT: Allow package.json and related files for builds
!package.json
!package-lock.json
!tsconfig*.json
!**/package.json
!**/package-lock.json
!**/tsconfig*.json

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
